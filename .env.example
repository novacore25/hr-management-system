# ═══════════════════════════════════════════════════════════════
# NovaCore HR Management System — Environment Variables
#
# File ini HANYA dokumentasi. Salin ke .env lalu isi dengan nilai asli.
# JANGAN PERNAH commit .env yang berisi nilai asli.
#
# Di produksi (Coolify), variabel ini diisi lewat UI Coolify:
#   Project → hr-management-system → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── DATABASE ──────────────────────────────────────────────────
# Coolify otomatis memberi variabel ini kalau app di-link ke
# database `db_hr_system`. Format Coolify:
DATABASE_URL="postgresql://USER:PASSWORD@db_hr_system:5432/db_hr_system"
# Format lokal (Windows / dev):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/db_hr_system"

# ── AUTH.JS v5 ────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="GANTI_DENGAN_32_BYTE_RANDOM_BASE64"

# WAJIB 1 karena aplikasi di belakang reverse proxy (Traefik)
AUTH_TRUST_HOST=1

# URL aplikasi — untuk production
AUTH_URL="https://app.tntkreatif.com"
# Untuk development lokal, uncomment:
# AUTH_URL="http://localhost:3000"

# Reuse OAuth Client dari app existing (Google Cloud Console)
AUTH_GOOGLE_ID="GANTI_DENGAN_GOOGLE_CLIENT_ID"
AUTH_GOOGLE_SECRET="GANTI_DENGAN_GOOGLE_CLIENT_SECRET"

# ── RUNTIME ───────────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
TZ=Asia/Jakarta

# ── STORAGE (opsional, default folder lokal) ──────────────────
# Nanti kalau Cloudflare R2 sudah siap, tambahkan:
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""
