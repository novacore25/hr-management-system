# ── Build context minimal ────────────────────────────────────
# VPS hanya punya 2 vCPU — semakin kecil context, semakin cepat.

node_modules
.next
out
build
dist

# Git
.git
.gitignore

# Env & secrets (TIDAK PERNAH masuk image)
.env
.env.*
!.env.example
*.pem
*.key
*service-account*.json

# Docs
*.md
!README.md
docs

# SQL legacy Supabase — sudah tidak dipakai runtime
supabase

# Runtime & tooling
.vscode
.idea
*.log
scripts
drizzle
data
uploads
storage

# Lockfile TIDAK di-ignore — npm ci butuh
!package-lock.json
